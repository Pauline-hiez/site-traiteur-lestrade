{# Opening banner.

   The illustration is an <img>, never a CSS background: a background image is
   invisible to search engines, cannot carry a description, and is fetched late.
   Above the fold, it is loaded eagerly and given priority. #}

<section class="bloc bloc-hero">

    {% include 'partials/image.html.twig' with {
        asset: bloc.image,
        alt: bloc.alt,
        classe: 'bloc-hero__image',
        sizes: '(min-width: 62rem) 960px, 100vw',
        eager: premier
    } only %}

        <div class="bloc-hero__texte">
        {% if bloc.surtitre %}
            <p class="bloc-hero__surtitre">{{ bloc.surtitre }}</p>
        {% endif %}

        {% if titre %}
            <h{{ niveau }} class="bloc-hero__titre">{{ titre }}</h{{ niveau }}>
        {% endif %}

        {% if bloc.accroche %}
            <p class="bloc-hero__accroche">{{ bloc.accroche }}</p>
        {% endif %}

        {% set bouton1 = bloc.boutonTexte and bloc.boutonLien %}
        {% set bouton2 = bloc.bouton2Texte and bloc.bouton2Lien %}

        {% if bouton1 or bouton2 %}
            <p class="bloc-hero__boutons">
                {% if bouton1 %}
                    <a class="bouton" href="{{ bloc.boutonLien }}">{{ bloc.boutonTexte }}</a>
                {% endif %}
                {% if bouton2 %}
                    <a class="bouton bouton--secondaire" href="{{ bloc.bouton2Lien }}">{{ bloc.bouton2Texte }}</a>
                {% endif %}
            </p>
        {% endif %}
    </div>

</section>
