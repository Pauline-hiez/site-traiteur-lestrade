{# Text next to an illustration. Below the fold, so the image is loaded lazily.
   Width and height are always written out: without them the page shifts as
   images arrive. #}

{% set position = bloc.positionImage|default('droite') %}

<section class="bloc bloc-texte-image bloc-texte-image--{{ position }}"{% if bloc.ancre %} id="{{ bloc.ancre }}"{% endif %}>

        <div class="bloc-texte-image__texte">
        {% if bloc.surtitre %}
            <p class="bloc-texte-image__surtitre">{{ bloc.surtitre }}</p>
        {% endif %}

        {% if titre %}
            <h{{ niveau }} class="bloc-texte-image__titre">{{ titre }}</h{{ niveau }}>
        {% endif %}

        {% if bloc.texte %}
            {# Rich text produced by the admin editor: intentionally not escaped. #}
            {{ bloc.texte|raw }}
        {% endif %}

        {% set bouton1 = bloc.boutonTexte and bloc.boutonLien %}
        {% set bouton2 = bloc.bouton2Texte and bloc.bouton2Lien %}

        {% if bouton1 or bouton2 %}
            <p class="bloc-texte-image__boutons">
                {% if bouton1 %}
                    <a class="bouton" href="{{ bloc.boutonLien }}">{{ bloc.boutonTexte }}</a>
                {% endif %}
                {% if bouton2 %}
                    <a class="bouton bouton--secondaire" href="{{ bloc.bouton2Lien }}">{{ bloc.bouton2Texte }}</a>
                {% endif %}
            </p>
        {% endif %}
    </div>

    {% include 'partials/image.html.twig' with {
        asset: bloc.image,
        alt: bloc.alt,
        classe: 'bloc-texte-image__image',
        sizes: '(min-width: 48rem) 30rem, 100vw'
    } only %}

</section>
