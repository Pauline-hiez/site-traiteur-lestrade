{# Contact form.

   Posts to the site itself — nothing leaves for a third party, no captcha
   service, no remote script. What guards it: a field no one sees, the time
   taken to fill the form, and a limit per address.

   Not offered at all when the write key is missing: better no form than one
   that silently loses messages. #}

{% set valeurs = formulaire.valeurs|default({}) %}
{% set champs = formulaire.champs|default({}) %}
{% set envoye = formulaire.envoye|default(false) %}

<section class="bloc bloc-formulaire" id="formulaire">

    <div class="bloc-formulaire__intro">
        {% if titre %}
            <h{{ niveau }} class="bloc-formulaire__titre">{{ titre }}</h{{ niveau }}>
        {% endif %}

        {% if bloc.texte %}
            {# Rich text produced by the admin editor: intentionally not escaped. #}
            {{ bloc.texte|raw }}
        {% endif %}

        {% include 'partials/image.html.twig' with {
            asset: bloc.image,
            alt: bloc.alt,
            classe: 'bloc-formulaire__image',
            sizes: '(min-width: 48rem) 33vw, 100vw'
        } only %}
    </div>

    <div class="bloc-formulaire__corps">

    {% if envoye %}
        <p class="message message--succes" role="status">
            Demande envoyée. Nous vous répondons sous 72 heures en semaine.
        </p>
    {% endif %}

    {% if not contactActif|default(false) %}

        {# Configuration missing: fall back on the details, which always work. #}
        <ul class="bloc-contact__coordonnees">
            {% if site.telephone %}
                <li><a href="tel:{{ tel_href(site.telephone) }}">{{ site.telephone }}</a></li>
            {% endif %}
            {% if site.email %}
                <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
            {% endif %}
        </ul>

    {% else %}

        {% if formulaire.erreur is defined %}
            <p class="message message--erreur" role="alert">{{ formulaire.erreur }}</p>
        {% endif %}

        <form class="formulaire" method="post" action="/contact" novalidate>

            <input type="hidden" name="jeton" value="{{ jetonContact }}">
            <input type="hidden" name="retour" value="{{ slug == accueilSlug|default('accueil') ? '/' : '/' ~ slug }}">

            {# Left empty by anyone who can see it. Hidden from assistive
               technologies too, so it is never announced. #}
            <div class="formulaire__piege" aria-hidden="true">
                <label for="site_web">Ne pas remplir ce champ</label>
                <input type="text" id="site_web" name="site_web" tabindex="-1" autocomplete="off">
            </div>

            <div class="devis" data-devis hidden>

                                <fieldset class="devis__groupe" data-etape>
                    <legend class="devis__titre">1. Votre événement</legend>

                    <fieldset class="devis__choix">
                        <legend>Type d’événement <span class="devis__requis" aria-hidden="true">*</span></legend>
                        {% for type in ['Mariage', 'Séminaire d’entreprise', 'Réception privée', 'Buffet ou plateaux à emporter'] %}
                            <label class="devis__option" for="devis-type-{{ loop.index }}">
                                <input type="radio" id="devis-type-{{ loop.index }}" name="devis-type" value="{{ type }}" required>
                                {{ type }}
                            </label>
                        {% endfor %}
                    </fieldset>

                    <p class="formulaire__champ">
                        <label for="devis-date">Date <span class="devis__requis" aria-hidden="true">*</span></label>
                        <input type="date" id="devis-date" name="devis-date" required>
                    </p>

                    <p class="formulaire__champ">
                        <label for="devis-convives">Nombre de convives <span class="devis__requis" aria-hidden="true">*</span></label>
                        <input type="number" id="devis-convives" name="devis-convives" min="1" inputmode="numeric" required>
                    </p>

                    <p class="formulaire__champ">
                        <label for="devis-lieu">Lieu de la réception</label>
                        <input type="text" id="devis-lieu" name="devis-lieu" placeholder="Nom du lieu ou de la commune">
                    </p>
                </fieldset>

                <fieldset class="devis__groupe" data-etape>
                    <legend class="devis__titre">2. Formule et budget</legend>

                    <fieldset class="devis__choix">
                        <legend>Formule envisagée</legend>
                        {# À tenir à jour avec la page Nos formules. #}
                        {% for formule in ['Cocktail découverte', 'Cocktail prestige', 'Buffet campagne', 'Repas assis Tradition', 'Repas assis Signature', 'Brunch du lendemain', 'Je ne sais pas encore'] %}
                            <label class="devis__option" for="devis-formule-{{ loop.index }}">
                                <input type="radio" id="devis-formule-{{ loop.index }}" name="devis-formule" value="{{ formule }}">
                                {{ formule }}
                            </label>
                        {% endfor %}
                    </fieldset>

                    <p><a href="/formules">Voir le détail des formules</a></p>

                    <p class="formulaire__champ">
                        <label for="devis-budget">Budget approximatif, en euros</label>
                        <input type="number" id="devis-budget" name="devis-budget" min="0" step="100" inputmode="numeric">
                    </p>
                </fieldset>

            </div>

            <div class="devis__etape" data-etape>
                <p class="devis__titre" data-devis hidden>3. Vos coordonnées</p>
                <p class="devis__mention" data-devis hidden><span aria-hidden="true">*</span> Champs obligatoires</p>

                        <p class="formulaire__champ">
                <label for="contact-nom">Votre nom</label>
                <input type="text" id="contact-nom" name="nom" required autocomplete="name"
                       value="{{ valeurs.nom|default('') }}"
                       {% if champs.nom is defined %}aria-invalid="true" aria-describedby="erreur-nom"{% endif %}>
                {% if champs.nom is defined %}
                    <span class="formulaire__erreur" id="erreur-nom">{{ champs.nom }}</span>
                {% endif %}
            </p>

            <p class="formulaire__champ">
                <label for="contact-email">Votre adresse e-mail</label>
                <input type="email" id="contact-email" name="email" required autocomplete="email"
                       value="{{ valeurs.email|default('') }}"
                       {% if champs.email is defined %}aria-invalid="true" aria-describedby="erreur-email"{% endif %}>
                {% if champs.email is defined %}
                    <span class="formulaire__erreur" id="erreur-email">{{ champs.email }}</span>
                {% endif %}
            </p>

                        <p class="formulaire__champ" data-devis hidden>
                <label for="devis-telephone">Téléphone</label>
                <input type="tel" id="devis-telephone" name="devis-telephone" autocomplete="tel">
            </p>

            <p class="formulaire__champ">
                <label for="contact-message">Votre demande</label>
                <span class="formulaire__aide" id="aide-message">
                    Indiquez la date, le type d’événement, le nombre de convives, le lieu,
                    la formule envisagée et une idée du budget.
                </span>
                <textarea id="contact-message" name="message" rows="8" required
                          aria-describedby="aide-message{% if champs.message is defined %} erreur-message{% endif %}"
                          {% if champs.message is defined %}aria-invalid="true"{% endif %}>{{ valeurs.message|default('') }}</textarea>
                {% if champs.message is defined %}
                    <span class="formulaire__erreur" id="erreur-message">{{ champs.message }}</span>
                {% endif %}
            </p>

            <p class="formulaire__consentement">
                {# Never checked in advance: consent that was not given by the
                   person is not consent. #}
                <input type="checkbox" id="contact-consentement" name="consentement" value="1"
                       {% if champs.consentement is defined %}aria-invalid="true" aria-describedby="erreur-consentement"{% endif %}>
                <label for="contact-consentement">
                    J’accepte que mon nom et mon adresse e-mail soient conservés pour répondre à ce
                    message.
                    {# The privacy page is written by the site itself, so the link can never
                       point at a page that was deleted or never created. #}
                    <a href="/confidentialite">Politique de confidentialité</a>.
                </label>
                {% if champs.consentement is defined %}
                    <span class="formulaire__erreur" id="erreur-consentement">{{ champs.consentement }}</span>
                {% endif %}
            </p>

            <p class="devis__navigation"><button type="submit" class="bouton">Envoyer ma demande</button></p>
            </div>

        </form>

    {% endif %}

    </div>

</section>
